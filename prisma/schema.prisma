datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  password         String
  role             String          @default("PATIENT")
  name             String
  phone            String?
  avatarUrl        String?
  status           String          @default("ACTIVE")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  doctorProfile    DoctorProfile?
  patientProfile   PatientProfile?
  notifications    Notification[]
  auditLogs        AuditLog[]
  reviews          Review[]
  sentMessages     Message[]       @relation("SentMessages")
  receivedMessages Message[]       @relation("ReceivedMessages")
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  icon        String   @default("Stethoscope")
  image       String?
  location    String?  @default("Building A, Floor 2")
  contact     String?  @default("+1 (555) 019-2800")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors      DoctorProfile[]
  appointments Appointment[]
  admissions   Admission[]
}

model DoctorProfile {
  id             String       @id @default(uuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  qualification  String
  licenseNo      String       @unique
  specialization String
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id])
  experienceYears Int         @default(5)
  consultationFee Float        @default(100.0)
  bio            String?
  languages      String?      @default("English, Spanish")
  address        String?
  status         String       @default("ACTIVE") // ACTIVE, PENDING, SUSPENDED, INACTIVE
  rating         Float        @default(4.9)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  schedules      Schedule[]
  doctorLeaves   DoctorLeave[]
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  labReports     LabReport[]
  emergencies    EmergencyCase[]
  admissions     Admission[]
  reviews        Review[]
}

model PatientProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientCode      String   @unique
  gender           String   @default("Other")
  dateOfBirth      DateTime
  bloodGroup       String   @default("O+")
  address          String?
  emergencyContact String?
  emergencyPhone   String?
  allergies        String?
  medicalConditions String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  appointments     Appointment[]
  medicalRecords   MedicalRecord[]
  prescriptions    Prescription[]
  labReports       LabReport[]
  invoices         Invoice[]
  emergencies      EmergencyCase[]
  admissions       Admission[]
}

model Schedule {
  id             String        @id @default(uuid())
  doctorId       String
  doctor         DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek      String
  startTime      String        @default("09:00 AM")
  endTime        String        @default("05:00 PM")
  breakStart     String?       @default("01:00 PM")
  breakEnd       String?       @default("02:00 PM")
  slotDuration   Int           @default(30)
  maxPatients    Int           @default(15)
  allowOnline    Boolean       @default(true)
  allowInPerson  Boolean       @default(true)
  isAvailable    Boolean       @default(true)
}

model DoctorLeave {
  id        String        @id @default(uuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  reason    String
  status    String        @default("APPROVED")
}

model Appointment {
  id            String            @id @default(uuid())
  appointmentNo String            @unique
  patientId     String
  patient       PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  departmentId  String
  department    Department        @relation(fields: [departmentId], references: [id])
  date          DateTime
  timeSlot      String
  reason        String
  notes         String?
  status        String            @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED, NO_SHOW
  paymentStatus String            @default("UNPAID")
  type          String            @default("In-Person")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  medicalRecord MedicalRecord?
  prescription  Prescription?
  invoice       Invoice?
  review        Review?
}

model MedicalRecord {
  id               String        @id @default(uuid())
  patientId        String
  patient          PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId         String
  doctor           DoctorProfile @relation(fields: [doctorId], references: [id])
  appointmentId    String?       @unique
  appointment      Appointment?  @relation(fields: [appointmentId], references: [id])
  chiefComplaint   String?
  symptoms         String
  diagnosis        String
  examinationNotes String?
  treatmentPlan    String
  doctorNotes      String?
  followUpDate     DateTime?
  
  // Vital Signs
  bloodPressure    String?       @default("120/80 mmHg")
  heartRate        String?       @default("72 bpm")
  temperature      String?       @default("98.6 °F")
  respiratoryRate  String?       @default("16 breaths/min")
  oxygenSaturation String?       @default("99%")
  weight           String?       @default("70 kg")
  height           String?       @default("175 cm")
  bmi              String?       @default("22.9 kg/m²")

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Prescription {
  id             String             @id @default(uuid())
  prescriptionNo String            @unique
  patientId      String
  patient        PatientProfile     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         DoctorProfile      @relation(fields: [doctorId], references: [id])
  appointmentId  String?            @unique
  appointment    Appointment?       @relation(fields: [appointmentId], references: [id])
  instructions   String?
  status         String             @default("ACTIVE")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  items          PrescriptionItem[]
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineName   String
  dosage         String
  frequency      String
  duration       String
  route          String       @default("Oral")
  instructions   String?
}

model Medicine {
  id            String   @id @default(uuid())
  name          String   @unique
  genericName   String
  category      String
  manufacturer  String
  batchNumber   String   @default("BATCH-2026-01")
  purchasePrice Float    @default(10.0)
  price         Float
  stockQuantity Int
  unit          String   @default("Tablets")
  expiryDate    DateTime
  status        String   @default("IN_STOCK")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LabTestCatalog {
  id          String   @id @default(uuid())
  testCode    String   @unique
  name        String   @unique
  category    String
  description String?
  price       Float
  sampleType  String   @default("Blood")
  turnaround  String   @default("24 Hours")
  createdAt   DateTime @default(now())
}

model LabReport {
  id        String        @id @default(uuid())
  reportNo  String        @unique
  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id])
  testName  String
  category  String
  result    String
  status    String        @default("COMPLETED")
  fileUrl   String?
  notes     String?
  testDate  DateTime      @default(now())
  createdAt DateTime      @default(now())
}

model InventoryItem {
  id            String   @id @default(uuid())
  name          String   @unique
  category      String   // MEDICINE, EQUIPMENT, CONSUMABLES, PPE, SURGICAL, LAB_SUPPLIES
  sku           String   @unique
  batchNumber   String?
  quantity      Int
  minStockLevel Int      @default(20)
  purchasePrice Float
  supplier      String   @default("Global Med Supplies")
  expiryDate    DateTime?
  status        String   @default("IN_STOCK")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EmergencyCase {
  id             String         @id @default(uuid())
  caseNo         String         @unique
  patientId      String
  patient        PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String?
  doctor         DoctorProfile? @relation(fields: [doctorId], references: [id])
  emergencyType  String
  priority       String         @default("Critical")
  status         String         @default("Waiting")
  arrivalTime    DateTime       @default(now())
  treatmentNotes String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Room {
  id         String   @id @default(uuid())
  roomNumber String   @unique
  wardName   String   @default("General Ward")
  roomType   String   @default("Private")
  dailyRate  Float    @default(250.0)
  createdAt  DateTime @default(now())

  beds       Bed[]
}

model Bed {
  id         String   @id @default(uuid())
  bedNumber  String   @unique
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  status     String   @default("Available")
  createdAt  DateTime @default(now())

  admissions Admission[]
}

model Admission {
  id             String         @id @default(uuid())
  admissionNo    String         @unique
  patientId      String
  patient        PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         DoctorProfile  @relation(fields: [doctorId], references: [id])
  departmentId   String
  department     Department     @relation(fields: [departmentId], references: [id])
  bedId          String
  bed            Bed            @relation(fields: [bedId], references: [id])
  admissionDate  DateTime       @default(now())
  reason         String
  diagnosis      String
  notes          String?
  status         String         @default("Admitted")

  discharge      Discharge?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Discharge {
  id                 String    @id @default(uuid())
  admissionId        String    @unique
  admission          Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  dischargeDate      DateTime  @default(now())
  finalDiagnosis     String
  treatmentSummary   String
  doctorInstructions String
  followUpDate       DateTime?
  dischargeNotes     String?
  createdAt          DateTime  @default(now())
}

model Review {
  id            String        @id @default(uuid())
  patientUserId String
  patientUser   User          @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentId String?       @unique
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  rating        Int           @default(5)
  comment       String
  status        String        @default("APPROVED")
  createdAt     DateTime      @default(now())
}

model HospitalService {
  id          String   @id @default(uuid())
  title       String   @unique
  category    String
  description String
  icon        String   @default("Activity")
  image       String
  status      String   @default("ACTIVE")
}

model Message {
  id          String   @id @default(uuid())
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String?
  recipient   User?    @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  subject     String
  message     String
  replyToId   String?
  replyTo     Message? @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: Cascade)
  replies     Message[] @relation("MessageReplies")
  status      String   @default("UNREAD") // UNREAD, READ, ARCHIVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNo     String        @unique
  patientId     String
  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?       @unique
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  subtotal      Float         @default(0.0)
  discount      Float         @default(0.0)
  tax           Float         @default(0.0)
  totalAmount   Float
  paidAmount    Float         @default(0.0)
  status        String        @default("UNPAID")
  dueDate       DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         InvoiceItem[]
  payments      Payment[]
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  category    String   @default("CONSULTATION")
  quantity    Int      @default(1)
  unitPrice   Float
  totalPrice  Float
}

model Payment {
  id            String   @id @default(uuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Float
  paymentMethod String   @default("Credit Card")
  transactionId String   @unique
  status        String   @default("COMPLETED")
  createdAt     DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  module    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
}
