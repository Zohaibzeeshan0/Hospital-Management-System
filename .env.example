# Database Connection URL (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# JWT Secret for Cookie Session Auth
AUTH_SECRET="medicare_nexus_super_secret_jwt_key_2026"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Email SMTP Adapter Configuration (Dev logger fallback if empty)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
SMTP_FROM="noreply@medicarenexus.com"

# Optional Payment Gateway Integration (Stripe / PayPal)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_sample"
STRIPE_SECRET_KEY="sk_test_sample"

# Storage Configuration (AWS S3 / Cloudinary)
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
